# Configurações do Discord Bot
DISCORD_TOKEN=seu_token_aqui

# Caminho do Banco de Dados SQLite (Permite volumes montados ex: /data/bot_database.db)
DB_PATH=bot_database.db

# ID do Canal de Texto Privado no Discord para Backup a Quente & Auto-Recuperação (Opcional - Zero Cloud Cost)
# Recomendado para hospedagens com disco efêmero como Koyeb, Render, Railway e Fly.io
BACKUP_CHANNEL_ID=

# Chave de API do IsThereAnyDeal (Opcional - para Menor Preço Histórico Real / All-Time Low na Steam)
# Obtenha gratuitamente em: https://isthereanydeal.com/
ITAD_API_KEY=
